        },
        "rating": {
          ".validate": "(newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && (root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.val() === data.val() || (data.parent().child('clientId').val() === auth.uid && (data.parent().child('status').val() === 'completed') && (newData.parent().child('status').val() === 'completed') && !data.parent().child('rating').exists())))"
        },
        "ratingBreakdown": {
          ".validate": "(root.child('users').child(auth.uid).child('role').val() === 'admin' || (data.parent().child('clientId').val() === auth.uid && (data.parent().child('status').val() === 'completed') && (newData.parent().child('status').val() === 'completed') && !data.parent().child('rating').exists()))"
        },
        "review": {
          ".validate": "(newData.isString() && newData.val().length <= 2000 && (root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.val() === data.val() || (data.parent().child('clientId').val() === auth.uid && (data.parent().child('status').val() === 'completed') && (newData.parent().child('status').val() === 'completed') && !data.parent().child('rating').exists())))"
        },
        "clientRating": {
          ".validate": "(root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.val() === data.val())"
        },
        "clientReview": {
          ".validate": "(root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.val() === data.val())"
        },
        "$other": {
          ".validate": "(root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.val() === data.val() || !data.parent().exists() || (data.parent().child('clientId').val() === auth.uid && (data.parent().child('status').val() === 'pending') && (newData.parent().child('status').val() === 'pending')))"
        }
      }
    },
    "bookingSecrets": {
      "$bookingId": {
        ".read": "auth != null && (root.child('bookings').child($bookingId).child('clientId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && newData.exists() && newData.parent().parent().child('bookings').child($bookingId).child('clientId').val() === auth.uid && newData.parent().parent().child('bookings').child($bookingId).child('status').val() === 'pending'))",
        ".validate": "newData.hasChildren(['startCode'])",
        "startCode": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "bookingLocations": {
      "$bookingId": {
        ".read": "auth != null && (root.child('bookings').child($bookingId).child('clientId').val() === auth.uid || root.child('bookings').child($bookingId).child('guardId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('bookings').child($bookingId).child('guardId').val() === auth.uid && (!newData.exists() || root.child('bookings').child($bookingId).child('status').val() === 'accepted' || root.child('bookings').child($bookingId).child('status').val() === 'en_route' || root.child('bookings').child($bookingId).child('status').val() === 'active')))",
        ".validate": "newData.hasChildren(['latitude', 'longitude', 'timestamp'])",
        "latitude": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "longitude": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "heading": {
          ".validate": "newData.isNumber()"
        },
        "speed": {
          ".validate": "newData.isNumber()"
        },
        "accuracy": {
          ".validate": "newData.isNumber()"
        },
        "timestamp": {
          ".validate": "newData.isNumber() || newData.isString()"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "guardBookingIndex": {
      "$guardId": {
        ".read": "auth != null && (auth.uid === $guardId || root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'company' && root.child('users').child($guardId).child('companyId').val() === auth.uid))",
        "$bookingId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === $guardId || newData.parent().parent().parent().child('bookings').child($bookingId).child('clientId').val() === auth.uid || root.child('bookings').child($bookingId).child('clientId').val() === auth.uid)",
          ".validate": "newData.val() === true"
        }
      }
    },
    "clientBookingIndex": {
      "$clientId": {
        ".read": "auth != null && (auth.uid === $clientId || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$bookingId": {
          ".write": "auth != null && (auth.uid === $clientId || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".validate": "newData.val() === true"
        }
      }
    },
    "users": {
      "$userId": {
        ".read": "auth != null && ($userId === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'company' && data.child('companyId').val() === auth.uid))",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (newData.exists() && ($userId === auth.uid || (root.child('users').child(auth.uid).child('role').val() === 'company' && data.child('companyId').val() === auth.uid))))",
        ".validate": "newData.hasChildren(['role'])",
        "role": {
          ".validate": "newData.isString() && (root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.val() === data.val() || (!data.exists() && $userId === auth.uid && newData.val().matches(/^(client|guard|company)$/)))"
        },
        "companyId": {
          ".validate": "newData.isString() && (root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.val() === data.val() || (!data.parent().exists() && $userId === auth.uid && newData.parent().child('role').val() === 'guard' && root.child('users').child(newData.val()).child('role').val() === 'company'))"
        },
        "$other": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
        }
      }
    },
    "chats": {
      ".read": false,
      ".write": false
    },
    "pushTokens": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId"
      }
    },
    "deviceTokens": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId"
      }
    }
  }
}
