rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Ayudantes
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Rol guardado en el perfil de Firestore. Es confiable SOLO porque ningun
    // camino de estas reglas deja a un no-admin escribir `role` (ver /users).
    function roleOf(uid) {
      return exists(userPath(uid)) ? get(userPath(uid)).data.get('role', null) : null;
    }

    function hasRole(role) {
      return isAuthenticated() && roleOf(request.auth.uid) == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isKYCApproved() {
      return isAuthenticated() && exists(userPath(request.auth.uid)) &&
        get(userPath(request.auth.uid)).data.get('kycStatus', null) == 'approved';
    }

    // La empresa que llama es la empresa de ese escolta.
    function isCompanyOf(userId) {
      return isAuthenticated() &&
        exists(userPath(userId)) &&
        get(userPath(userId)).data.get('companyId', null) == request.auth.uid &&
        hasRole('company');
    }

    // Participantes de una reserva. La reserva vive en Realtime Database, que
    // estas reglas no pueden leer, asi que el cliente mantiene en Firestore
    // bookingParticipants/{bookingId} = {clientId, guardId, updatedAt}.
    function participantsPath(bookingId) {
      return /databases/$(database)/documents/bookingParticipants/$(bookingId);
    }

    function isBookingParticipant(bookingId) {
      return isAuthenticated() && exists(participantsPath(bookingId)) &&
        request.auth.uid in [
          get(participantsPath(bookingId)).data.get('clientId', null),
          get(participantsPath(bookingId)).data.get('guardId', null)
        ];
    }

    // Campos que solo cambia un administrador (o el servidor con Admin SDK).
    function ownerLockedFields() {
      return ['role', 'isActive', 'suspended', 'companyId', 'rating', 'completedJobs',
              'ratingBreakdown', 'reviewCount', 'emailVerified', 'pushToken'];
    }

    // Los documentos KYC ya no viven en el perfil publico (lo lee cualquier
    // usuario autenticado): van a users/{uid}/private/kyc.
    function kycUrlFields() {
      return ['governmentIdUrls', 'licenseUrls', 'vehicleDocUrls', 'insuranceUrls'];
    }

    function noPublicKycUrls(data) {
      return data.get('governmentIdUrls', []).size() == 0 &&
             data.get('licenseUrls', []).size() == 0 &&
             data.get('vehicleDocUrls', []).size() == 0 &&
             data.get('insuranceUrls', []).size() == 0;
    }

    // Lo que una empresa puede editar del perfil de SU escolta.
    function companyEditableGuardFields() {
      return ['firstName', 'lastName', 'phone', 'language', 'bio', 'height', 'weight',
              'languages', 'photos', 'outfitPhotos', 'certifications', 'hourlyRate',
              'availability', 'isFreelancer', 'kycStatus', 'companyId', 'updatedAt'];
    }

    // =========================================================================
    // USERS
    // =========================================================================
    match /users/{userId} {
      // `read` cubre get y list. El perfil de un escolta es visible para
      // cualquier autenticado (las pantallas de cliente listan escoltas); los
      // demas perfiles solo para el dueno, admin y la empresa de ese escolta.
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        resource.data.role == 'guard' ||
        isAdmin() ||
        (hasRole('company') && resource.data.get('companyId', null) == request.auth.uid)
      );

      // Alta del propio perfil. Nunca como admin, siempre con KYC pendiente,
      // activo, sin reputacion inventada y sin suspension.
      // companyId solo se acepta para un escolta y solo si apunta a una
      // empresa real: es el alta que hace company-guards.tsx con una sesion
      // secundaria del escolta nuevo.
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasAll(['email', 'role', 'kycStatus', 'isActive']) &&
        request.resource.data.role in ['client', 'guard', 'company'] &&
        request.resource.data.kycStatus == 'pending' &&
        request.resource.data.isActive == true &&
        request.resource.data.get('suspended', false) == false &&
        request.resource.data.get('rating', 0) == 0 &&
        request.resource.data.get('completedJobs', 0) == 0 &&
        request.resource.data.get('reviewCount', 0) == 0 &&
        request.resource.data.get('emailVerified', false) == false &&
        !('ratingBreakdown' in request.resource.data) &&
        !('pushToken' in request.resource.data) &&
        noPublicKycUrls(request.resource.data) &&
        (
          request.resource.data.get('companyId', null) == null ||
          (request.resource.data.role == 'guard' &&
           roleOf(request.resource.data.companyId) == 'company')
        );

      allow create: if isAdmin();

      // Dueno: cualquier campo salvo los bloqueados. kycStatus solo puede
      // volver a 'pending' (reenviar documentos), nunca aprobarse solo.
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(ownerLockedFields()) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['kycStatus']) ||
          request.resource.data.kycStatus == 'pending') &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(kycUrlFields()) ||
          noPublicKycUrls(request.resource.data));

      // Empresa: solo SUS escoltas, solo campos de perfil/foto, kycStatus solo
      // a 'pending' y companyId solo a null (dar de baja al escolta).
      allow update: if isAuthenticated() &&
        resource.data.role == 'guard' &&
        resource.data.get('companyId', null) == request.auth.uid &&
        hasRole('company') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(companyEditableGuardFields()) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['kycStatus']) ||
          request.resource.data.kycStatus == 'pending') &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['companyId']) ||
          request.resource.data.get('companyId', null) == null);

      allow update, delete: if isAdmin();

      // Datos sensibles del escolta (URLs de documentos KYC). Solo el dueno,
      // la empresa de ese escolta y admin.
      match /private/{docId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == userId ||
          isAdmin() ||
          isCompanyOf(userId)
        );
      }
    }

    // =========================================================================
    // BOOKING PARTICIPANTS (espejo minimo de la reserva de RTDB para el chat)
    // =========================================================================
    // Lo crea el CLIENTE justo despues de crear la reserva, y solo el mismo
    // cliente puede cambiar guardId (reasignacion).
    match /bookingParticipants/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.guardId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['clientId', 'guardId', 'updatedAt']) &&
        request.resource.data.clientId == request.auth.uid &&
        request.resource.data.guardId is string &&
        request.resource.data.guardId != request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.clientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guardId', 'updatedAt']) &&
        request.resource.data.guardId is string &&
        request.resource.data.guardId != request.auth.uid;
      allow write: if isAdmin();
    }

    // =========================================================================
    // BOOKINGS (legado). Las reservas viven en Realtime Database; este bloque
    // queda solo para datos viejos y ya no admite altas de clientes.
    // =========================================================================
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.guardId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // =========================================================================
    // MESSAGES (chat de una reserva)
    // =========================================================================
    // La lectura usa participantIds porque el chat se lista con
    // where(bookingId ==) + where(participantIds array-contains uid), y una
    // regla de lista solo puede apoyarse en campos del filtro.
    function validNewMessage() {
      let msg = request.resource.data;
      let p = get(participantsPath(msg.bookingId)).data;
      return msg.senderId == request.auth.uid &&
        request.auth.uid in [p.clientId, p.guardId] &&
        msg.clientId == p.clientId &&
        msg.get('guardId', null) == p.guardId &&
        msg.participantIds is list &&
        msg.participantIds.hasOnly([p.clientId, p.guardId]) &&
        request.auth.uid in msg.participantIds &&
        msg.senderRole == (request.auth.uid == p.clientId ? 'client' : 'guard') &&
        msg.text is string && msg.text.size() > 0 && msg.text.size() <= 4000 &&
        msg.get('read', false) == false;
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;

      allow create: if isAuthenticated() &&
        request.resource.data.bookingId is string &&
        exists(participantsPath(request.resource.data.bookingId)) &&
        validNewMessage();

      // Solo el destinatario, y solo para marcarlo como leido.
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participantIds &&
        request.auth.uid != resource.data.senderId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']) &&
        request.resource.data.read == true;

      allow delete: if false;
    }

    // === TYPING: indicador efimero de chat (id = bookingId_userId) ===
    match /typing/{typingId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        typingId == request.resource.data.bookingId + '_' + request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // =========================================================================
    // DOCUMENTS
    // =========================================================================
    match /documents/{documentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // =========================================================================
    // EMERGENCY ALERTS
    // =========================================================================
    match /emergencyAlerts/{alertId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isBookingParticipant(resource.data.bookingId)
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || isOwner(resource.data.userId);
      allow delete: if isAdmin();
    }

    // =========================================================================
    // PAYMENTS
    // =========================================================================
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.guardId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        hasRole('client') && request.resource.data.clientId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // === KYC AUDIT LOGS (legado) ===
    match /kycAuditLog/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // === RATE LIMITS ===
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    // === TELEMETRIA: la escribe el cliente, solo la lee el administrador ===
    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /errors/{errorId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /analytics/{eventId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /performance/{metricId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // === WEBHOOKS: solo el servidor (Admin SDK ignora estas reglas) ===
    match /webhook_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /webhook_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // === DEVICE TOKENS (Push Notifications) ===
    // Consentimientos (LFPDPPP): cada quien lee y cambia solo los suyos; el
    // historial es de solo alta para que sirva de bitacora. Admin puede leer.
    match /consents/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if false;

      match /history/{entryId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }
    }

    match /deviceTokens/{tokenId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // =========================================================================
    // NOTIFICATIONS (cola de avisos push)
    // =========================================================================
    // El cliente solo encola {userId, senderId, type, bookingId?, status:
    // 'pending'}. El titulo y el cuerpo los arma el servidor con una plantilla
    // por `type` (functions/src/notificaciones.ts); lo que el cliente mande
    // en title/body se ignora. El destinatario es uno mismo o la otra parte
    // de una reserva en la que ambos participan.
    function notificationTypes() {
      return ['booking_created', 'booking_accepted', 'booking_rejected', 'guard_en_route',
              'service_started', 'service_completed', 'new_message', 'payment_success',
              'payment_failed', 'emergency', 'new_booking_request', 'booking_cancelled',
              'booking_confirmed', 'booking_reassigned'];
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.userId is string &&
        request.resource.data.type in notificationTypes() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.get('read', false) == false &&
        (
          request.resource.data.userId == request.auth.uid ||
          (request.resource.data.bookingId is string &&
           exists(participantsPath(request.resource.data.bookingId)) &&
           request.auth.uid in [
             get(participantsPath(request.resource.data.bookingId)).data.clientId,
             get(participantsPath(request.resource.data.bookingId)).data.guardId
           ] &&
           request.resource.data.userId in [
             get(participantsPath(request.resource.data.bookingId)).data.clientId,
             get(participantsPath(request.resource.data.bookingId)).data.guardId
           ])
        );
      // El destinatario solo puede marcarla como leida.
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if false;
    }

    // =========================================================================
    // PAYOUTS / LEDGER: dinero. Solo servidor y administracion.
    // =========================================================================
    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && (
        resource.data.guardId == request.auth.uid || isAdmin()
      );
      // Las solicitudes de pago las crea el servidor (Admin SDK), que calcula
      // el saldo real. Un cliente no puede inventarse un pago.
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /ledger/{entryId} {
      allow read: if isAuthenticated() && (
        resource.data.guardId == request.auth.uid || isAdmin()
      );
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // =========================================================================
    // REVIEWS: las escribe el cliente de esa reserva, una vez.
    // =========================================================================
    match /reviews/{reviewId} {
      // Reputacion publica del escolta; solo con sesion.
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasAll(['bookingId', 'guardId', 'clientId', 'rating']) &&
        request.resource.data.keys().hasOnly(['bookingId', 'guardId', 'clientId', 'rating',
          'ratingBreakdown', 'review', 'comment', 'createdAt', 'clientName']) &&
        request.resource.data.clientId == request.auth.uid &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.bookingId is string &&
        exists(participantsPath(request.resource.data.bookingId)) &&
        get(participantsPath(request.resource.data.bookingId)).data.clientId == request.auth.uid &&
        get(participantsPath(request.resource.data.bookingId)).data.guardId == request.resource.data.guardId;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // INCIDENT REPORTS
    // =========================================================================
    match /incidentReports/{reportId} {
      allow read: if isAuthenticated() && (
        resource.data.reportedBy == request.auth.uid ||
        isAdmin() ||
        isBookingParticipant(resource.data.bookingId)
      );
      allow create: if isAuthenticated() &&
        request.resource.data.reportedBy == request.auth.uid &&
        request.resource.data.keys().hasAll(['bookingId', 'reportedBy', 'type', 'severity', 'status']);
      // Quien reporta puede completar su reporte; cerrarlo es del administrador.
      allow update: if isAuthenticated() && (
        (resource.data.reportedBy == request.auth.uid &&
         request.resource.data.reportedBy == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if false;
    }

    // === DELETION REQUESTS: obligacion legal ===
    match /deletion_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // === KYC AUDIT LOG: solo se agrega, nunca se edita ni se borra ===
    match /kyc_audit_log/{entryId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isCompanyOf(request.resource.data.userId)
      );
      allow update, delete: if false;
    }

    // === REFUNDS: solo administracion ===
    match /refunds/{refundId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // === INVOICES: las escribe generateInvoice (Admin SDK) ===
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid || isAdmin()
      );
      allow write: if false;
    }

    // === TELEMETRIA DE COSTOS ===
    match /usage_metrics/{metricId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /cost_alerts/{alertId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // El limitador de peticiones vive en el cliente: este registro es
    // evidencia, no un control.
    match /rateLimitViolations/{violationId} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // === DEFAULT DENY ===
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
